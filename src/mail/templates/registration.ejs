<!DOCTYPE html>

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TASK MASTER — Account Activation</title>
    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f3f6fb;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
      }

      .wrapper {
        width: 100%;
        padding: 40px 10px;
        background-color: #f3f6fb;
      }

      .card {
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        border-radius: 14px;
        box-shadow: 0 10px 32px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: 1px solid #eaeaea;
      }

      .header {
        background: linear-gradient(135deg, #00c853, #64dd17);
        padding: 28px 20px;
        text-align: center;
        color: white;
      }

      .logo {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 1px;
      }

      .subtitle {
        margin: 4px 0 0;
        font-size: 13px;
        opacity: 0.9;
      }

      .content {
        padding: 28px;
        color: #333;
        line-height: 1.6;
      }

      .greeting {
        font-size: 18px;
        font-weight: 600;
        margin-top: 0;
      }

      .info-box {
        background-color: #f9fafc;
        border-radius: 10px;
        border: 1px solid #ececec;
        padding: 16px;
        margin: 18px 0;
      }

      .info-item {
        margin-bottom: 8px;
        font-size: 14px;
        color: #555;
      }

      .info-item:last-child {
        margin-bottom: 0;
      }

      .info-item strong {
        color: #111;
      }

      .cta-wrapper {
        text-align: center;
        margin: 28px 0;
      }

      .cta-button {
        background: linear-gradient(135deg, #00c853, #64dd17);
        color: #ffffff !important;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 15px;
        display: inline-block;
        box-shadow: 0 6px 16px rgba(0, 200, 83, 0.4);
      }

      .note {
        font-size: 13px;
        color: #777;
      }

      .link {
        font-size: 12px;
        word-break: break-all;
        color: #444;
      }

      .footer {
        background-color: #f5f7fa;
        text-align: center;
        font-size: 12px;
        padding: 14px;
        color: #666;
      }

      @media (max-width: 600px) {
        .content {
          padding: 20px;
        }

        .cta-button {
          padding: 12px 20px;
          font-size: 14px;
        }

        .greeting {
          font-size: 16px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="card">
        <div class="header">
          <div class="logo">TASK MASTER</div>
          <p class="subtitle">Account Activation</p>
        </div>

        <div class="content">
          <p class="greeting">Hello <%= full_name %>,</p>

          <p>
            Thank you for joining
            <strong>TASK MASTER</strong>. To start using your account, please
            verify your email address by clicking the button below.
          </p>

          <div class="info-box">
            <div class="info-item">
              <strong>Full Name:</strong>
              <%= full_name %>
            </div>

            <div class="info-item">
              <strong>Email Address:</strong>
              <%= email %>
            </div>

            <div class="info-item">
              <strong>Registration Date:</strong>
              <%= createdAt %>
            </div>
          </div>

          <div class="cta-wrapper">
            <a href="<%= activationLink %>" class="cta-button">
              Activate Account
            </a>
          </div>

          <p class="note">
            If the button above does not work, copy and paste the following link
            into your browser:
          </p>

          <p class="link"><%= activationLink %></p>

          <p class="note">
            If you did not create a TASK MASTER account, you can safely ignore
            this email.
          </p>

          <p>
            Best regards,<br />
            <strong>TASK MASTER Team</strong>
          </p>
        </div>

        <div class="footer">&copy; 2026 TASK MASTER. All rights reserved.</div>
      </div>
    </div>
  </body>
</html>
