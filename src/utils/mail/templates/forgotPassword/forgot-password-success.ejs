<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>TASK MASTER — Reset Password</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background-color: #f3f6fb;
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
      }

      .wrapper {
        width: 100%;
        padding: 40px 10px;
        background-color: #f3f6fb;
      }

      .card {
        max-width: 600px;
        margin: auto;
        background-color: #ffffff;
        border-radius: 14px;
        box-shadow: 0 10px 32px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        border: 1px solid #eaeaea;
      }

      .header {
        background: linear-gradient(135deg, #ff9800, #ff5722);
        padding: 28px 20px;
        text-align: center;
        color: white;
      }

      .logo {
        font-size: 22px;
        font-weight: 700;
        letter-spacing: 1px;
      }

      .content {
        padding: 28px;
        color: #333;
        line-height: 1.6;
      }

      .greeting {
        font-size: 18px;
        font-weight: 600;
      }

      .info-box {
        background-color: #fff8f1;
        border-radius: 10px;
        border: 1px solid #ffe0b2;
        padding: 16px;
        margin: 18px 0;
      }

      .info-item {
        margin-bottom: 6px;
        font-size: 14px;
        color: #555;
      }

      .info-item strong {
        color: #111;
      }

      .cta-wrapper {
        text-align: center;
        margin: 28px 0;
      }

      .cta-button {
        background: linear-gradient(135deg, #ff9800, #ff5722);

        color: white !important;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 15px;
        display: inline-block;
        box-shadow: 0 6px 16px rgba(255, 87, 34, 0.35);
      }

      .cta-button:hover {
        opacity: 0.9;
      }

      .note {
        font-size: 13px;
        color: #777;
      }

      .warning {
        font-size: 13px;
        color: #d32f2f;
        font-weight: 500;
      }

      .footer {
        background-color: #f5f7fa;
        text-align: center;
        font-size: 12px;
        padding: 14px;
        color: #666;
      }

      @media (max-width: 600px) {
        .content {
          padding: 20px;
        }

        .cta-button {
          padding: 12px 20px;
          font-size: 14px;
        }

        .greeting {
          font-size: 16px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="card">
        <div class="header">
          <div class="logo">TASK MASTER</div>

          <p style="margin: 4px 0 0; font-size: 13px; opacity: 0.9">
            Reset Password
          </p>
        </div>

        <div class="content">
          <p class="greeting">Halo <%= full_name %>,</p>

          <p>
            Kami menerima permintaan untuk mereset password akun
            <strong>TASK MASTER</strong> kamu.
          </p>

          <div class="info-box">
            <div class="info-item">
              Klik tombol di bawah untuk membuat password baru.
            </div>

            <div class="info-item">
              Link ini hanya berlaku selama
              <strong> 5 menit </strong>.
            </div>
          </div>

          <div class="cta-wrapper">
            <a href="<%= resetLink %>" class="cta-button">
              🔐 Reset Password
            </a>
          </div>

          <p class="note">
            Jika tombol tidak bekerja, copy & paste link berikut ke browser:
          </p>

          <p style="font-size: 12px; word-break: break-all"><%= resetLink %></p>

          <p class="warning">
            Jika kamu tidak meminta reset password, abaikan email ini.
          </p>
        </div>

        <div class="footer">&copy; 2026 TASK MASTER — All rights reserved</div>
      </div>
    </div>
  </body>
</html>
